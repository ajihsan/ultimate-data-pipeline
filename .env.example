# Realtime pipeline endpoints and credentials for local dev.
# Copy to .env and fill in real values; .env is gitignored — never commit it.

# Redpanda (Kafka API)
REDPANDA_BOOTSTRAP=localhost:9092

# ClickHouse (host ports 8123/9000 are fixed in docker-compose.yaml,
# bound to 127.0.0.1 only)
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=udp-dev-password
CLICKHOUSE_DB=udp

# Redpanda Console UI (host port; 8080 is taken by qBittorrent on this box)
REDPANDA_CONSOLE_PORT=8085

# Postgres (CDC source, ingested via Conduit)
# NOTE: changing POSTGRES_PASSWORD requires editing the literal DSN in
# conduit/conduit.yaml too (conduit pipeline configs don't do env expansion).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=udp
POSTGRES_PASSWORD=udp-dev-password
POSTGRES_DB=udp

# Laya decision model server (S5).
# Default: the in-network containerized server (`make model-container` or
# `make up-model`; see docker-compose.yaml `model` service). A HOST-run
# server instead: run it with MODEL_HOST=0.0.0.0, set
# MODEL_ENDPOINT_URL=http://host.docker.internal:8081/v1/systemone (the
# decide container cannot reach the host's 127.0.0.1), and allow docker
# subnets through ufw (see Makefile note).
MODEL_ENDPOINT_URL=http://model:8081/v1/systemone

# Notify trigger thresholds (consumed by the S6 notify pipeline; finalized
# from the S5 eval — see docs/jev_eval.md):
#   scam ≥ 0.35: precision 1.00 / recall 0.87 on labeled tickets (the sweep
#     plateau is 0.3–0.4; the old 0.6 default missed 35% of scam reports).
#   escalate ≥ 0.75: the head ships temperature 1.98 (smoothed toward 0.5);
#     0.8 never fires and 0.7 is low-precision (F1 0.44 vs the scam-proxy
#     label). 0.75 keeps the upper tail only; the S6 rate limiter is the
#     noise guardrail.
THRESHOLD_ESCALATE_P=0.75
THRESHOLD_SCAM_P=0.35

# Hugging Face cache for the TheRock model weights (S0)
HF_HOME=.hf-cache

# Notifications (S6 notify pipeline: connect/notify.yaml).
# NOTIFY_PROVIDER: comma-separated list of delivery providers per alert —
#   log (DEFAULT: summary logged, no HTTP — safe with no receiver),
#   mock (POST ALERT_RECEIVER_URL — the compose.mock.yaml alert-receiver),
#   telegram and/or discord (real channels; both allowed: "telegram,discord").
# Going live with Telegram: create a bot via @BotFather, get a chat id
# (e.g. via @userinfobot), then set:
#   TELEGRAM_BOT_TOKEN=<bot token>
#   TELEGRAM_CHAT_ID=<chat id>
# Going live with Discord: channel → Integrations → Webhooks → copy URL:
#   DISCORD_WEBHOOK_URL=<webhook url>
# ALERT_RECEIVER_URL is only used by the mock provider (compose.mock.yaml
# default shown). Failed deliveries are logged; the udp.alerts row is always
# written either way.
NOTIFY_PROVIDER=log
ALERT_RECEIVER_URL=http://alert-receiver:8082/alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Alert rate limit (S6 notify pipeline): max DELIVERED alerts per epoch
# minute — drop-and-record (extras are kept in udp.alerts with
# suppressed=true). Never silently lost.
ALERT_RATE_LIMIT_PER_MIN=10
