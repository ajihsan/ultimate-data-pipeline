# Realtime pipeline endpoints and credentials for local dev.
# Copy to .env and fill in real values; .env is gitignored — never commit it.

# Redpanda (Kafka API)
REDPANDA_BOOTSTRAP=localhost:9092

# ClickHouse (ports bound to 127.0.0.1 only)
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=udp-dev-password
CLICKHOUSE_DB=udp

# Redpanda Console UI (host port; 8080 is taken by qBittorrent on this box)
REDPANDA_CONSOLE_PORT=8085

# Postgres (CDC source, ingested via Conduit)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=udp
POSTGRES_PASSWORD=udp-dev-password
POSTGRES_DB=udp

# Laya decision model server (S5).
# Default: the in-network containerized server (`make model-container` or
# `make up-model`; see docker-compose.yaml `model` service). A HOST-run
# server instead: set MODEL_ENDPOINT_URL=http://127.0.0.1:8081/v1/systemone,
# run `make model`, and allow docker subnets through ufw (see Makefile note).
MODEL_ENDPOINT_URL=http://model:8081/v1/systemone

# Notify trigger thresholds (consumed by the S6 notify pipeline; finalized
# from the S5 eval — see docs/jev_eval.md):
#   scam ≥ 0.35: precision 1.00 / recall 0.87 on labeled tickets (the sweep
#     plateau is 0.3–0.4; the old 0.6 default missed 35% of scam reports).
#   escalate ≥ 0.75: the head ships temperature 1.98 (smoothed toward 0.5);
#     0.8 never fires and 0.7 is low-precision (F1 0.44 vs the scam-proxy
#     label). 0.75 keeps the upper tail only; the S6 rate limiter is the
#     noise guardrail.
THRESHOLD_ESCALATE_P=0.75
THRESHOLD_SCAM_P=0.35

# Hugging Face cache for the TheRock model weights (S0)
HF_HOME=.hf-cache

# Notifications (wired in S8); NOTIFY_PROVIDER=mock keeps alerts out of real chats
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
NOTIFY_PROVIDER=mock
