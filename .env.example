# Realtime pipeline endpoints and credentials for local dev.
# Copy to .env and fill in real values; .env is gitignored — never commit it.

# Redpanda (Kafka API)
REDPANDA_BOOTSTRAP=localhost:9092

# ClickHouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Postgres (CDC source, ingested via Conduit)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=udp
POSTGRES_PASSWORD=
POSTGRES_DB=udp

# Laya decision model server (wired in S5)
MODEL_ENDPOINT_URL=http://127.0.0.1:8081/v1/systemone

# Hugging Face cache for the TheRock model weights (S0)
HF_HOME=.hf-cache

# Notifications (wired in S8); NOTIFY_PROVIDER=mock keeps alerts out of real chats
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
NOTIFY_PROVIDER=mock
